{
  "name": "callauth",
  "version": "0.0.1",
  "description": "app de bloqueio de ligações",
  "productName": "Callauth",
  "author": "Diogo <diogobezerra5@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "restart": "npm run stop && npm run start",
    "start": "quasar dev --debug --port 443 > server.log 2>&1 & echo $! > server.pid",
    "stop": "[ -f server.pid ] && kill $(cat server.pid) && rm -f server.pid",
    "android": "cp capacitor.config.dev.json capacitor.config.json && quasar build && npx cap sync android && sudo chmod -R 777 /paynbox"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@quasar/extras": "^1.16.4",
    "pinia": "^3.0.3",
    "quasar": "^2.16.0",
    "typescript": "^5.8.2",
    "vue": "^3.4.18",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.0.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "javascript-obfuscator": "^4.1.1",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.8.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
